{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build:client": "vite build --mode client",
		"build:server": "vite build --ssr",
		"build": "bun run build:client && bun run build:server",
		"preview": "NODE_ENV=production bun server.ts",
		"build:vercel": "bun run build",
		"build:netlify": "bun run build",
		"build:cloudflare": "bun run build && wrangler deploy",
		"build:docker": "docker build -t monorepo-web .",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@monorepo/api": "workspace:*",
		"@consolidados/hono-vite-runtime": "workspace:*",
		"@monorepo/navigation": "workspace:*",
		"@monorepo/ui": "workspace:*",
		"@tanstack/react-devtools": "^0.7.0",
		"@tanstack/react-query": "^5.90.20",
		"@tanstack/react-query-devtools": "^5.84.2",
		"hono": "^4.11.5",
		"install": "^0.13.0",
		"npm": "^11.8.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@hono/vite-dev-server": "^0.24.1",
		"@monorepo/config": "workspace:*",
		"@tailwindcss/postcss": "^4.1.11",
		"@tanstack/react-query-devtools": "^5.91.2",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"bun-types": "^1.2.3",
		"fast-glob": "^3.3.3",
		"postcss": "^8.4.49",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.7.3",
		"vite": "^6.0.7",
		"vite-tsconfig-paths": "^5.1.4"
	}
}
