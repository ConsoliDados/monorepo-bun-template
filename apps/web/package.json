{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build --mode client",
    "build:server": "vite build --ssr",
    "build": "bun run build:client && bun run build:server",
    "preview": "NODE_ENV=production bun run server/node.ts",
    "build:vercel": "bun run build",
    "build:netlify": "bun run build",
    "build:cloudflare": "bun run build && wrangler deploy",
    "build:docker": "docker build -t monorepo-web .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@monorepo/api": "workspace:*",
    "@monorepo/ui": "workspace:*",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.157.5",
    "@tanstack/react-router-devtools": "^1.157.5",
    "@tanstack/router-plugin": "^1.157.0",
    "hono": "^4.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.24.1",
    "@monorepo/config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.2.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
