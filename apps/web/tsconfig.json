{
	"extends": "@monorepo/config/tsconfig-react",
	"compilerOptions": {
		"types": ["bun-types", "vite/client"],
		"allowImportingTsExtensions": true,
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"],
			"@monorepo/api": ["../../packages/api/src/index.ts"],
			"@monorepo/api/*": ["../../packages/api/src/*"],
			"@monorepo/ui": ["../../packages/ui/src/index.ts"],
			"@monorepo/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": [
		"src/**/*",
		"server/**/*",
		"src/.react-router/types/**/*",
		"src/**/*.d.ts"
	],
	"exclude": ["node_modules"]
}
